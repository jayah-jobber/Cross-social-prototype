    "build:research:dashboard": "VITE_PROTOTYPE_VERSION=version_4 VITE_RESEARCH_MODE=true VITE_ENTRY_SURFACE=dashboard VITE_NAVIGATION_STYLE=arrows npm run build",
    "build:research:adhoc": "VITE_PROTOTYPE_VERSION=version_4 VITE_RESEARCH_MODE=true VITE_ENTRY_SURFACE=adhoc VITE_NAVIGATION_STYLE=arrows npm run build",
    "preview": "vite preview",
    "verify:channel-switcher": "node verify-channel-icon-switcher.mjs",
    "verify:icon-style": "node verify-v4-icon-style.mjs",
    "verify:v4-adhoc": "node verify-v4-adhoc.mjs",
    "verify:v4-adhoc-create": "node verify-v4-adhoc-create.mjs",
    "verify:v4-dashboard": "node verify-v4-dashboard.mjs",
    "verify:v4-prompt-lifecycle": "node verify-v4-prompt-lifecycle.mjs",
    "verify:v4-generated-reopen": "node verify-v4-generated-reopen.mjs",
    "verify:v4-navigation": "node verify-v4-navigation-style.mjs",
    "verify:v4-review-typography": "node verify-v4-review-typography.mjs",
    "verify:v4-social-editor": "node verify-v4-social-editor.mjs",
    "verify:v4-loading": "node verify-v4-loading.mjs",
    "verify:v4-suggested-persistence": "node verify-v4-suggested-persistence.mjs",
    "verify:v4-review-status": "node verify-v4-review-status.mjs",
    "verify:v4-lifecycle": "node verify-v4-lifecycle.mjs",
    "verify:v4-linked-split": "node verify-v4-linked-split.mjs",
    "verify:v4-delete-all": "node verify-v4-delete-all.mjs",
    "verify:v4-topic-completion": "node verify-v4-topic-completion.mjs",
    "verify:v4-calendar-tasks": "node verify-v4-calendar-tasks.mjs",
    "verify:research": "node verify-research-mode.mjs"
